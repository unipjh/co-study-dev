VITE_E2E_AUTH=true

# Option A: Use a real Firebase Email/Password test account.
# Enable Email/Password in Firebase Authentication and create this account manually.
VITE_E2E_AUTH_EMAIL=playwright-test@example.com
VITE_E2E_AUTH_PASSWORD=change-this-password

# Option B: Use local Firebase emulators instead of real Firebase services.
# When this is true, Auth, Firestore, and Storage all point at localhost.
VITE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199
